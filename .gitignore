/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get large
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Uncomment if you have Asset Bundles in your project
# /[Aa]ssetBundles/
# /[Ss]treaming[Aa]ssets/

# Autogenerated Crash Report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ddressables[Bb]uild[Rr]eports/
/[Aa]ddressables/aa/*
/[Pp]latforms/

